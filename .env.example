# =============================================================================
# Q-Med Environment Variables â€” Template (SQLite edition)
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# --- Backend (SQLite â€” no separate DB server needed) ---
# SQLite file path inside container (do not change unless you know what you're doing)
DATABASE_URL=sqlite:////app/data/qmed.db

# Secret key for JWT â€” generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_64_char_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM AI Chatbot ---
# Hugging Face Access Token to download google/medgemma-4b-it
HF_TOKEN=hf_your_token_here
# Optional local snapshot (recommended for reliable/offline startup)
MEDGEMMA_MODEL_PATH=ml_models/medgemma-4b-it
HF_HOME=./.hf_cache
# 4-bit quantization requires an NVIDIA CUDA GPU. Keep false on CPU.
USE_4BIT=false

# Product evaluation: return plausible measurement results after 3 seconds.
# Set to false to run the real CPU video-analysis models.
EXPO_PUBLIC_DEMO_MEASUREMENTS=true

# --- Ports (optional override) ---
BACKEND_PORT=6789
