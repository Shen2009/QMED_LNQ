# EAS Build ignore file
# node_modules are re-installed by EAS on the build server
node_modules/

# Expo cache
.expo/

# Test files & results
tests/
test-results/
playwright.config.ts
playwright-report/
__tests__/

# Build output
dist/
web-build/
android/
ios/

# Dev artifacts
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# Secrets / local env (should never be in archive)
.env.local
.env*.local
